---
import Base from '../layouts/Base.astro';
import Contacto from '../components/Contacto.astro';
import { firma, contactoPrincipal, type Area } from '../data/firma';

export function getStaticPaths() {
  return firma.areas.map((area) => ({ params: { area: area.slug }, props: { area } }));
}

const { area } = Astro.props as { area: Area };
const mensaje = `Hola, me interesa el servicio de ${area.titulo.toLowerCase()} de VC Consultores.`;
const cta = contactoPrincipal(mensaje);
const otra = firma.areas.find((a) => a.slug !== area.slug);
// Las respuestas pendientes de confirmar no se muestran, ni siquiera en un borrador.
const preguntas = area.preguntas.filter((q) => !q.r.startsWith('PENDIENTE'));
const titulos: Record<string, string> = {
  contabilidad: 'Contador en Tuxtla Gutiérrez: contabilidad, impuestos y SAT',
  legal: 'Abogados en Tuxtla Gutiérrez: corporativo, laboral, fiscal y civil',
};
---
<Base titulo={`${titulos[area.slug] ?? area.titulo} | VC Consultores`} descripcion={`${area.resumen} ${area.intro}`.slice(0, 160)}>
  <section class="cabeza">
    <div class="contenedor">
      <nav class="migas" aria-label="Ruta"><a href="/">Inicio</a> / <span>{area.titulo}</span></nav>
      <h1>{area.titulo}</h1>
      <p class="entrada">{area.intro}</p>
      <a class="boton boton--primario" href={cta.href} {...(cta.externo ? { rel: 'noopener', target: '_blank' } : {})}>{cta.texto}</a>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <p class="antetitulo">Qué hacemos</p>
      <h2>Servicios de {area.titulo.toLowerCase()}</h2>
      <div class="servicios">
        {area.servicios.map((s) => (
          <article><h3>{s.titulo}</h3><p>{s.texto}</p></article>
        ))}
      </div>
    </div>
  </section>

  {preguntas.length > 0 && (
    <section class="seccion">
      <div class="contenedor faq">
        <div>
          <p class="antetitulo">Preguntas frecuentes</p>
          <h2>Lo que más nos preguntan</h2>
        </div>
        <div>
          {preguntas.map((q) => (
            <details><summary>{q.p}</summary><p>{q.r}</p></details>
          ))}
        </div>
      </div>
    </section>
  )}

  {otra && (
    <section class="seccion seccion--blanca cruzada">
      <div class="contenedor">
        <p class="antetitulo">También te ayudamos con</p>
        <a href={`/${otra.slug}/`}><strong>{otra.titulo}</strong> — {otra.resumen} →</a>
      </div>
    </section>
  )}

  <Contacto mensajeWhatsapp={mensaje} />
</Base>

<style>
  .cabeza { padding-block: clamp(2.5rem, 7vw, 5rem); background: radial-gradient(1000px 400px at 90% 0%, var(--ambar-claro), transparent 60%); }
  .cabeza .entrada { margin-bottom: 2rem; }
  .migas { font-size: .9rem; color: var(--gris); margin-bottom: 1.5rem; }
  .migas a { color: var(--ambar-osc); }
  .servicios { display: grid; gap: 1.25rem; margin-top: 2rem; }
  @media (min-width: 700px) { .servicios { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .servicios { grid-template-columns: repeat(3, 1fr); } }
  .servicios article { border: 1px solid var(--linea); border-radius: var(--radio); padding: 1.75rem; border-top: 3px solid var(--ambar); }
  .servicios p { color: var(--gris); margin: 0; }
  .faq { display: grid; gap: 2rem; }
  @media (min-width: 860px) { .faq { grid-template-columns: 1fr 1.6fr; gap: 4rem; } }
  details { border-bottom: 1px solid var(--linea); padding-block: 1.1rem; }
  summary { cursor: pointer; font-weight: 600; font-size: 1.05rem; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--ambar-osc); font-size: 1.4rem; line-height: 1; }
  details[open] summary::after { content: '–'; }
  details p { color: var(--gris); margin: .75rem 0 0; }
  .cruzada a { font-size: 1.15rem; text-decoration: none; }
  .cruzada a:hover strong { color: var(--ambar-osc); }
</style>
